# Express + SQLite app configuration
NODE_ENV=development
PORT=3000
DATA_DIR=./data
APP_BASE_URL=http://localhost:3000

# Local bootstrap only. First sign-in must change this password.
# In production, set a unique password in Coolify; the temporary password is refused.
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=Admin@12345

# Random secret used only to pseudonymize consented analytics sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=replace-with-a-random-32-byte-hex-value

# Google OAuth (optional until configured)
# Register the exact redirect URI: https://your-domain.example/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Twilio Verify (required to send OTPs; no simulated delivery is used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Google Analytics 4 (loads only after analytics consent)
GA4_MEASUREMENT_ID=

# Server-side GA4 admin reports (optional)
# Enable the Google Analytics Data API and grant this service account Viewer access to the GA4 property.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
# Keep the private key in server secrets; newlines may be represented as \n.
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Remote MCP bearer tokens. Generate independent random values and keep server-side.
# Read-only token can call read tools; write token can create/update drafts only.
MCP_READ_TOKEN=
MCP_WRITE_TOKEN=
